QMainWindow, QWidget {
    background: #d9dde1;
    color: #20252a;
    font-family: "Segoe UI", "Tahoma", sans-serif;
    font-size: 9pt;
}
QMenuBar, QMenu, QToolBar, QStatusBar {
    background: #eceff1;
    color: #20252a;
    border: 1px solid #aeb5bc;
}
QMenuBar::item { padding: 3px 8px; }
QMenuBar::item:selected, QMenu::item:selected { background: #c6d8e8; color: #142b3d; }
QToolBar { spacing: 3px; padding: 2px; }
QDockWidget { border: 1px solid #aeb5bc; }
QDockWidget::title {
    background: #c6ccd2;
    padding: 4px 6px;
    border-bottom: 1px solid #939da6;
    text-align: left;
    font-weight: 600;
}
QGroupBox {
    border: 1px solid #aeb5bc;
    margin-top: 8px;
    padding: 6px 4px 4px 4px;
    font-weight: 600;
}
QGroupBox::title { subcontrol-origin: margin; left: 7px; padding: 0 3px; }
QLineEdit, QDoubleSpinBox, QSpinBox, QComboBox, QPlainTextEdit, QTableView {
    background: #f8f9fa;
    color: #20252a;
    border: 1px solid #9da7af;
    selection-background-color: #3875a5;
    selection-color: white;
    padding: 2px;
}
QPushButton {
    background: #e6e9ec;
    border: 1px solid #89949d;
    padding: 4px 9px;
}
QPushButton:hover { background: #d8e4ed; }
QPushButton:pressed { background: #c4d4e0; }
QPushButton:disabled { color: #92999f; background: #e2e4e6; }
QTabWidget::pane { border: 1px solid #9da7af; top: -1px; }
QTabBar::tab {
    background: #cbd1d6;
    border: 1px solid #9da7af;
    padding: 4px 10px;
    margin-right: 1px;
}
QTabBar::tab:selected { background: #f0f2f4; border-bottom-color: #f0f2f4; }
QHeaderView::section {
    background: #d4d9de;
    border: 1px solid #aeb5bc;
    padding: 3px;
    font-weight: 600;
}
QProgressBar { border: 1px solid #9da7af; text-align: center; }
QProgressBar::chunk { background: #4d84ad; }
QScrollArea { border: 0; }
QSplitter::handle { background: #b4bcc3; }
QToolTip { background: #ffffe1; color: #20252a; border: 1px solid #777777; }
